rules_version = '2';

// Photo storage for Flushy Flash.
//
// Note: a Storage download URL, once issued, bypasses these rules entirely. All
// imagery here is effectively public to anyone holding a link. That is acceptable
// for restroom and avatar photos - do not reuse this bucket for anything else.
//
// contentType is client-asserted and can be spoofed. Before launch, add a
// Storage-triggered function that checks magic bytes and deletes non-images.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function withinSizeLimit() {
      return request.resource.size < 8 * 1024 * 1024;
    }

    // Uploader is recorded in metadata so a moderator can attribute an image
    // without reading Firestore.
    function declaresUploader() {
      return request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /restrooms/{restroomId}/{photoId} {
      // Public, matching the restroom documents these belong to — a guest
      // browsing the map sees the photos too.
      allow read: if true;
      allow create: if isSignedIn() && isImage() && withinSizeLimit() && declaresUploader();
      // Photos are immutable: replacing bytes behind an existing URL would let
      // someone swap approved content for something else after the fact.
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.metadata.uploadedBy == request.auth.uid;
    }

    /**
     * Review photos.
     *
     * Their own prefix rather than being filed under restrooms/. Sharing that
     * one would have needed no rules change at all, which is tempting — but a
     * review photo in the restroom's namespace IS a restroom photo to the first
     * person who looks, and the review id is `${restroomId}_${uid}`, so this
     * prefix already encodes both the restroom and the author. That is what
     * makes abuse triage and orphan cleanup possible without reading Firestore.
     *
     * Otherwise line-for-line the restrooms block: public read (reviews are
     * world-readable), immutable, deletable only by the uploader.
     */
    match /reviews/{reviewId}/{photoId} {
      allow read: if true;
      allow create: if isSignedIn() && isImage() && withinSizeLimit() && declaresUploader();
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.metadata.uploadedBy == request.auth.uid;
    }

    match /users/{uid}/avatar/{avatarId} {
      // Public, matching users/{uid} in firestore.rules: avatars appear beside
      // review authors, and reviews are readable by guests.
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && request.resource.size < 2 * 1024 * 1024
        && declaresUploader();
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
