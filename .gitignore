# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Uniwind generated types
uniwind-env.d.ts

# Firebase admin credentials for the seed script — NEVER commit
service-account*.json

# Note: google-services.json and GoogleService-Info.plist ARE committed on
# purpose. They are client distribution config, not secrets: they ship inside
# every APK/IPA and are trivially extractable. Security rules and App Check are
# the real boundary.

# Per-agent skill links are absolute symlinks created by `npx skills add`.
# The real skill content lives in .agents/skills/ and is committed; these are
# regenerated locally by `npx skills add` and would break on another machine.
.claude/skills/
