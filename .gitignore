# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# `.env*.local` does NOT match a bare `.env`. The repo is public, and
# .env.example's tooling section documents admin credentials for
# `seed:buildings --upload` — which belong in a .env by convention. Ignore it.
.env

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Uniwind generated types
uniwind-env.d.ts

# Firebase admin credentials for the seed script — NEVER commit
service-account*.json

# Firebase client config. Not strictly secret — it ships inside every APK and is
# extractable — but this repo is PUBLIC, and published API keys get scraped for
# signup spam and quota burn. CI reads it from the GOOGLE_SERVICES_JSON secret;
# security rules and App Check remain the real boundary.
google-services.json
GoogleService-Info.plist

# Android signing. Leaking it lets anyone ship a malicious update over the real
# app; losing it means installed apps can never be updated again. Back it up
# offline, outside this repo.
*.keystore
*.jks

# Per-agent skill links are absolute symlinks created by `npx skills add`.
# The real skill content lives in .agents/skills/ and is committed; these are
# regenerated locally by `npx skills add` and would break on another machine.
.claude/skills/

# Generated by `npm run seed:buildings`; regenerate rather than trusting a stale
# copy. The reviewed version is what gets uploaded.
# scripts/buildings.seed.csv  (kept in git on purpose — it is the reviewed seed)

# Firebase emulator output
firestore-debug.log
database-debug.log
ui-debug.log
firebase-debug.log
.firebase/
