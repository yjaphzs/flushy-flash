{
  "name": "flushy-flash",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "node scripts/check-firebase-config.mjs && expo prebuild --clean && node scripts/configure-android-build.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor",
    "seed:buildings": "tsx scripts/seed-buildings.ts",
    "grant:admin": "tsx scripts/grant-admin.ts",
    "backfill:trust": "tsx scripts/backfill-trust.ts",
    "test:rules": "npx --yes firebase-tools@15.30.0 emulators:exec --only firestore --project flushy-flash-rules-test \"npm --prefix rules test\"",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && npm --prefix rules run typecheck && npm --prefix functions run typecheck",
    "prebuild:android": "node scripts/check-firebase-config.mjs --platform android && expo prebuild --platform android --clean && node scripts/configure-android-build.mjs",
    "firebase:placeholder": "node scripts/make-placeholder-firebase-config.mjs",
    "firebase:emulators": "npx --yes firebase-tools@15.30.0 emulators:start",
    "deploy:rules": "npx --yes firebase-tools@15.30.0 deploy --project flushy-flash --only firestore:rules,firestore:indexes,database,storage --non-interactive",
    "deploy:functions": "npm --prefix functions run build && npx --yes firebase-tools@15.30.0 deploy --project flushy-flash --only functions --non-interactive",
    "firebase:sdkconfig": "npx --yes firebase-tools@15.30.0 apps:sdkconfig android --project flushy-flash --out google-services.json"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@legendapp/list": "3.4.0",
    "@maplibre/maplibre-react-native": "11.3.10",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/database": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/functions": "26.4.0",
    "@react-native-firebase/storage": "26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "57.0.24",
    "expo-application": "57.0.3",
    "expo-blur": "57.0.3",
    "expo-build-properties": "57.0.21",
    "expo-constants": "57.0.19",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-image-manipulator": "57.0.19",
    "expo-image-picker": "57.0.19",
    "expo-intent-launcher": "57.0.1",
    "expo-linking": "57.0.10",
    "expo-location": "57.0.19",
    "expo-router": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "heroui-native": "1.0.9",
    "lottie-react-native": "7.3.8",
    "lucide-react-native": "1.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "uniwind": "1.12.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "firebase-admin": "14.4.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "tailwindcss": "4.3.3",
    "test-renderer": "1.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/rules/",
      "<rootDir>/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|heroui-native|uniwind|@legendapp/.*|@gorhom/.*|react-native-reanimated|react-native-worklets|@react-native-google-signin/.*|tailwind-variants|tailwind-merge|@maplibre/.*|lottie-react-native))"
    ],
    "resolver": "./node_modules/react-native-worklets/jest/resolver.js",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    }
  }
}
