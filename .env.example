# Copy to .env.local (gitignored) and adjust. Every value here has a working
# default, so the app runs with no .env file at all.
#
# Expo only inlines variables prefixed EXPO_PUBLIC_, and it does so AT BUILD TIME.
# They are readable inside the shipped APK. Nothing secret belongs in this file.

# ─────────────────────────────────────────────────────────────────────────────
# Firebase
# ─────────────────────────────────────────────────────────────────────────────
# There is deliberately no EXPO_PUBLIC_FIREBASE_API_KEY / PROJECT_ID / APP_ID.
#
# This app uses @react-native-firebase — the NATIVE SDKs. They read the project
# config from google-services.json (Android) and GoogleService-Info.plist (iOS),
# compiled into the binary at prebuild. There is no initializeApp({ apiKey })
# call in this codebase, so those variables would be dead config that looks
# meaningful. That pattern belongs to the Firebase JS SDK, which this project
# does not use. See src/lib/env.ts.
#
# To point the app at a different Firebase project, swap those two files and
# re-run `npx expo prebuild --clean` — not an env var.

# Talk to locally running emulators instead of the real backend.
# Start them with:  npx firebase-tools emulators:start
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=false

# Where the emulators are reachable from the DEVICE, which is not the same as
# from your machine:
#   Android emulator  -> 10.0.2.2   (the alias for host loopback; the default)
#   iOS simulator     -> 127.0.0.1  (the default)
#   physical device   -> your machine's LAN IP, e.g. 192.168.1.10  (set it here)
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# Only needed if you change the ports in firebase.json. Firestore is on 8181
# rather than the usual 8080, which is commonly already in use.
# EXPO_PUBLIC_FIREBASE_EMULATOR_PORT_AUTH=9099
# EXPO_PUBLIC_FIREBASE_EMULATOR_PORT_FIRESTORE=8181
# EXPO_PUBLIC_FIREBASE_EMULATOR_PORT_STORAGE=9199
# EXPO_PUBLIC_FIREBASE_EMULATOR_PORT_DATABASE=9000

# ─────────────────────────────────────────────────────────────────────────────
# Map
# ─────────────────────────────────────────────────────────────────────────────
# MapLibre vector tile style. Defaults to OpenFreeMap (free, keyless, OSM-based)
# so the app works with no setup. Swap for MapTiler/Protomaps if you need custom
# styling or a guaranteed SLA — those require an API key in the URL.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ─────────────────────────────────────────────────────────────────────────────
# Tooling — NOT read by the app, and NOT prefixed EXPO_PUBLIC_
# ─────────────────────────────────────────────────────────────────────────────
# Admin credentials for `npm run seed:buildings -- --upload`. This one IS a real
# secret: it is a service-account key with full project access. Keep it out of
# git (service-account*.json is gitignored) and never expose it to the app.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# CI additionally needs these as GitHub repository secrets, not .env values:
#   GOOGLE_SERVICES_JSON        base64 of google-services.json
#   ANDROID_KEYSTORE_BASE64     base64 of the release keystore
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
