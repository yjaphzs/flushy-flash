# Only EXPO_PUBLIC_* variables are inlined into the JS bundle by Expo.
# Nothing secret belongs here — these ship inside the app binary.

# MapLibre vector tile style. Defaults to OpenFreeMap (free, keyless, OSM-based)
# when unset, so the app works out of the box. Swap for MapTiler/Protomaps if you
# need custom styling or guaranteed SLAs.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
